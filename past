/* ==========================================================
   7. 예약 시스템
   - 화요일 휴무 / 10:00~17:00 / 마지막 예약 16:00
   - 구글 캘린더 초대 링크 + 인스타 DM 요청
   ========================================================== */
(function booking(){
  const $ = function(id){ return document.getElementById(id); };
  const pad = function(n){ return String(n).padStart(2,'0'); };
  const DOW = ['일','월','화','수','목','금','토'];

  const state = { prog:null, date:null, slot:null, people:2 };

  const today = new Date(); today.setHours(0,0,0,0);
  const maxDate = new Date(today); maxDate.setDate(maxDate.getDate() + CONFIG.bookAheadDays);
  let viewY = today.getFullYear(), viewM = today.getMonth();

  /* ---- 7-1. 프로그램 버튼 ---- */
  $('progGrid').innerHTML = PROGRAMS.map(function(p){
    const price = p.price ? p.price.toLocaleString('ko-KR')+'원 / '+p.unit : '견적 문의';
    return '<button class="prog" data-id="'+p.id+'" aria-pressed="false">'
      + '<b>'+p.name+'</b><span>'+p.min+'분 소요</span><em>'+price+'</em></button>';
  }).join('');

  $('progGrid').addEventListener('click', function(e){
    const b = e.target.closest('.prog');
    if(!b) return;
    [].forEach.call($('progGrid').children, function(x){ x.setAttribute('aria-pressed','false'); });
    b.setAttribute('aria-pressed','true');
    state.prog = PROGRAMS.filter(function(p){ return p.id === b.dataset.id; })[0];
    state.slot = null;
    renderSlots();
    updateSummary();
  });

  /* ---- 7-2. 달력 ---- */
  function isClosed(d){ return d.getDay() === CONFIG.closedWeekday; }
  function inRange(d){ return d >= today && d <= maxDate; }
  function key(d){ return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate()); }

  function renderCal(){
    $('calTitle').textContent = viewY + '년 ' + (viewM+1) + '월';

    const first = new Date(viewY, viewM, 1);
    const lastDay = new Date(viewY, viewM+1, 0).getDate();
    let html = DOW.map(function(d,i){
      return '<div class="dow'+(i===0?' sun':'')+'">'+d+'</div>';
    }).join('');

    for(let i=0; i<first.getDay(); i++) html += '<div class="day empty"></div>';

    for(let d=1; d<=lastDay; d++){
      const dt = new Date(viewY, viewM, d);
      const disabled = isClosed(dt) || !inRange(dt);
      const isToday = dt.getTime() === today.getTime();
      const selected = state.date && key(state.date) === key(dt);
      html += '<button class="day'+(isToday?' today':'')+'" data-d="'+d+'"'
            + ' aria-pressed="'+(selected?'true':'false')+'"'
            + (disabled?' disabled':'')
            + ' title="'+(isClosed(dt)?'화요일 휴무':'')+'">'+d+'</button>';
    }
    $('calGrid').innerHTML = html;

    // 이전 달 버튼: 이번 달보다 앞으로는 못 감
    $('calPrev').disabled = (viewY === today.getFullYear() && viewM === today.getMonth());
    const maxY = maxDate.getFullYear(), maxM = maxDate.getMonth();
    $('calNext').disabled = (viewY === maxY && viewM === maxM);
  }

  $('calGrid').addEventListener('click', function(e){
    const b = e.target.closest('.day');
    if(!b || b.disabled || !b.dataset.d) return;
    state.date = new Date(viewY, viewM, +b.dataset.d);
    state.slot = null;
    renderCal();
    renderSlots();
    updateSummary();
  });
  $('calPrev').addEventListener('click', function(){
    viewM--; if(viewM < 0){ viewM = 11; viewY--; } renderCal();
  });
  $('calNext').addEventListener('click', function(){
    viewM++; if(viewM > 11){ viewM = 0; viewY++; } renderCal();
  });

  /* ---- 7-3. 시간 슬롯 ---- */
  function buildSlots(durMin){
    // 시작 가능 시각 = 10:00 ~ min(16:00, 17:00 - 소요시간), 30분 간격
    const start = CONFIG.openHour * 60;
    const limit = Math.min(CONFIG.lastBooking * 60, CONFIG.closeHour * 60 - durMin);
    const out = [];
    for(let t = start; t <= limit; t += 30) out.push(t);
    return out;
  }

  function renderSlots(){
    const wrap = $('slotWrap');
    if(!state.date){
      wrap.innerHTML = '<div class="slot-empty">먼저 날짜를 선택해 주세요.</div>';
      return;
    }
    if(!state.prog){
      wrap.innerHTML = '<div class="slot-empty">먼저 프로그램을 선택해 주세요. 프로그램마다 소요 시간이 달라 가능한 시간대가 바뀝니다.</div>';
      return;
    }
    const slots = buildSlots(state.prog.min);

    // 오늘 날짜라면 이미 지난 시간대는 선택할 수 없게 막습니다
    const now = new Date();
    const isToday = state.date.getTime() === today.getTime();
    const nowMin = now.getHours()*60 + now.getMinutes();
    const passed = function(t){ return isToday && t <= nowMin; };

    if(slots.every(passed)){
      wrap.innerHTML = '<div class="slot-empty">오늘은 예약 가능한 시간이 지났습니다. '
        + '다른 날짜를 선택하시거나, 당일 방문은 인스타그램 DM으로 문의해 주세요.</div>';
      return;
    }

    wrap.innerHTML = '<div class="slot-grid">'
      + slots.map(function(t){
          const h = Math.floor(t/60), m = t%60;
          const end = t + state.prog.min;
          const label = pad(h)+':'+pad(m);
          return '<button class="slot" data-t="'+t+'" aria-pressed="'+(state.slot===t?'true':'false')+'"'
               + (passed(t) ? ' disabled title="이미 지난 시간입니다"' : ' title="'+label+' ~ '+pad(Math.floor(end/60))+':'+pad(end%60)+'"')
               + '>'+label+'</button>';
        }).join('')
      + '</div>'
      + '<div class="hint" style="font-size:12.5px;color:var(--ink-faint);margin-top:10px;">'
      + state.prog.name + ' · ' + state.prog.min + '분 소요 · 마지막 예약 '
      + pad(Math.floor(slots[slots.length-1]/60)) + ':' + pad(slots[slots.length-1]%60)
      + (isToday ? ' · 당일 예약은 DM으로 한 번 더 확인해 주세요' : '') + '</div>';
  }

  $('slotWrap').addEventListener('click', function(e){
    const b = e.target.closest('.slot');
    if(!b || b.disabled) return;
    state.slot = +b.dataset.t;
    [].forEach.call($('slotWrap').querySelectorAll('.slot'), function(s){
      s.setAttribute('aria-pressed', +s.dataset.t === state.slot ? 'true' : 'false');
    });
    updateSummary();
  });

  /* ---- 7-4. 요약 ---- */
  $('bkPeople').addEventListener('change', function(){
    state.people = +this.value || 1;
    updateSummary();
  });

  function priceText(){
    if(!state.prog) return '–';
    if(!state.prog.price) return '견적 문의';
    const total = state.prog.unit === '2인'
      ? state.prog.price * Math.max(1, Math.ceil(state.people/2))
      : state.prog.price * state.people;
    return total.toLocaleString('ko-KR') + '원';
  }

  function dateText(){
    if(!state.date) return null;
    const d = state.date;
    return (d.getMonth()+1)+'월 '+d.getDate()+'일 ('+DOW[d.getDay()]+')';
  }
  function timeText(){
    if(state.slot === null || !state.prog) return null;
    const end = state.slot + state.prog.min;
    return pad(Math.floor(state.slot/60))+':'+pad(state.slot%60)
         + ' ~ ' + pad(Math.floor(end/60))+':'+pad(end%60);
  }

  function setCell(el, text){
    if(text){ el.textContent = text; el.classList.remove('todo'); }
    else { el.textContent = '선택 전'; el.classList.add('todo'); }
  }

  function updateSummary(){
    setCell($('sumProg'), state.prog ? state.prog.name : null);
    setCell($('sumDate'), dateText());
    setCell($('sumTime'), timeText());
    $('sumPeople').textContent = state.people >= 6 ? '6명 이상' : state.people + '명';
    $('sumPrice').textContent = priceText();
    const ready = !!(state.prog && state.date && state.slot !== null);
    $('btnGcal').disabled = !ready;
    $('btnIg').disabled = !ready;
  }

  /* ---- 7-5. 예약 텍스트 / 구글 캘린더 ---- */
  function summaryText(){
    const name = ($('bkName').value || '').trim();
    const note = ($('bkNote').value || '').trim();
    return '[' + CONFIG.brand + ' 예약 요청]\n'
      + '· 프로그램: ' + state.prog.name + ' (' + state.prog.min + '분)\n'
      + '· 날짜: ' + state.date.getFullYear() + '년 ' + dateText() + '\n'
      + '· 시간: ' + timeText() + '\n'
      + '· 인원: ' + (state.people >= 6 ? '6명 이상' : state.people + '명') + '\n'
      + '· 예상 금액: ' + priceText() + '\n'
      + (name ? '· 예약자: ' + name + '\n' : '')
      + (note ? '· 요청사항: ' + note + '\n' : '');
  }

  function gcalStamp(minutesFromMidnight){
    const d = state.date;
    return d.getFullYear() + pad(d.getMonth()+1) + pad(d.getDate())
         + 'T' + pad(Math.floor(minutesFromMidnight/60)) + pad(minutesFromMidnight%60) + '00';
  }

  $('btnGcal').addEventListener('click', function(){
    const name = ($('bkName').value || '').trim();
    const title = CONFIG.brand + ' · ' + state.prog.name + (name ? ' (' + name + ')' : '');
    const params = new URLSearchParams({
      action:  'TEMPLATE',
      text:    title,
      dates:   gcalStamp(state.slot) + '/' + gcalStamp(state.slot + state.prog.min),
      ctz:     'Asia/Seoul',
      details: summaryText() + '\n문의 · 확정: 인스타그램 DM ' + CONFIG.igHandle + '\n' + CONFIG.instagram,
      location: CONFIG.address,
      add:     CONFIG.ownerEmail
    });
    window.open('https://calendar.google.com/calendar/render?' + params.toString(), '_blank', 'noopener');
  });

  $('btnIg').addEventListener('click', function(){
    const text = summaryText();
    const done = function(){
      const msg = $('copiedMsg');
      msg.classList.add('show');
      setTimeout(function(){ msg.classList.remove('show'); }, 6000);
      window.open(CONFIG.instagram, '_blank', 'noopener');
    };
    if(navigator.clipboard && navigator.clipboard.writeText){
      navigator.clipboard.writeText(text).then(done, done);
    } else {
      const ta = document.createElement('textarea');
      ta.value = text; ta.style.position='fixed'; ta.style.opacity='0';
      document.body.appendChild(ta); ta.select();
      try{ document.execCommand('copy'); }catch(err){}
      document.body.removeChild(ta);
      done();
    }
  });

  renderCal();
  renderSlots();
  updateSummary();
})();

/* ==========================================================
   8. 오시는 길 — Leaflet 지도 (실패해도 안내 카드는 동작)
   ========================================================== */
(function initVisit(){
  const sideEl = document.getElementById('mapSide');
  const controlsEl = document.getElementById('mapControls');
  const mapEl = document.getElementById('map');
  let drawOnMap = null;

  function selectMode(mode){
    const r = ROUTES[mode];
    if(!r) return;
    sideEl.innerHTML = r.cards.map(function(c){
      return '<div class="route-card"><h4><span class="ico">'+c.ico+'</span>'+c.h+'</h4>'
           + '<p>'+c.p+'</p><div class="time">'+c.t+'</div></div>';
    }).join('');
    if(drawOnMap) drawOnMap(mode);
  }

  controlsEl.addEventListener('click', function(e){
    const b = e.target.closest('.mbtn');
    if(!b) return;
    [].forEach.call(controlsEl.querySelectorAll('.mbtn'), function(x){ x.classList.remove('active'); });
    b.classList.add('active');
    selectMode(b.dataset.mode);
  });

  selectMode('car');

  if (typeof L === 'undefined'){
    mapEl.innerHTML =
      '<div style="height:100%;display:grid;place-items:center;text-align:center;padding:40px;">'
      + '<div><div style="font-size:32px;margin-bottom:12px;">🗺️</div>'
      + '<div style="font-weight:800;margin-bottom:6px;">지도를 불러오지 못했습니다</div>'
      + '<div style="color:#97A29A;font-size:14px;line-height:1.7;">인터넷 연결을 확인해 주세요.<br>주소: '
      + CONFIG.address + '</div></div></div>';
    return;
  }

  const map = L.map(mapEl, { scrollWheelZoom:false }).setView([33.5030, 126.5115], 13);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom:19, attribution:'&copy; OpenStreetMap contributors'
  }).addTo(map);

  const pin = function(bg, emoji, size){
    size = size || 42;
    return L.divIcon({
      className:'',
      html:'<div style="width:'+size+'px;height:'+size+'px;border-radius:50% 50% 50% 6px;transform:rotate(-45deg);'
         + 'background:'+bg+';box-shadow:0 8px 20px -7px rgba(0,0,0,.55);border:2px solid #fff;'
         + 'display:grid;place-items:center;">'
         + '<span style="transform:rotate(45deg);font-size:'+Math.round(size*0.44)+'px;line-height:1;">'+emoji+'</span></div>',
      iconSize:[size,size], iconAnchor:[size/2,size], popupAnchor:[0,-size+6]
    });
  };

  L.marker([CONFIG.airport.lat, CONFIG.airport.lng], { icon: pin('#12BFB0','✈️') })
   .addTo(map).bindPopup('<b>제주국제공항</b>출발지 · 3번 게이트 앞 버스 / 택시 승강장');

  L.circleMarker([CONFIG.cityhall.lat, CONFIG.cityhall.lng], {
    radius:7, color:'#FFD43B', fillColor:'#FFD43B', fillOpacity:.95, weight:2
  }).addTo(map).bindPopup('<b>제주시청</b>공방까지 도보 3분');

  L.circleMarker([CONFIG.busStop.lat, CONFIG.busStop.lng], {
    radius:6, color:'#12BFB0', fillColor:'#12BFB0', fillOpacity:.95, weight:2
  }).addTo(map).bindPopup('<b>제주시청 정류장</b>365 · 315번 하차');

  const shopMarker = L.marker([CONFIG.shop.lat, CONFIG.shop.lng], { icon: pin('#FF8A3D','🍊',48) })
   .addTo(map).bindPopup('<b>'+CONFIG.brand+'</b>'+CONFIG.address+'<br>10:00–17:00 · 화요일 휴무');

  let routeLayer = null;
  drawOnMap = function(mode){
    const r = ROUTES[mode];
    if(routeLayer) map.removeLayer(routeLayer);
    const line = L.polyline(r.path);
    routeLayer = L.layerGroup([
      L.polyline(r.path, { color:'#2B332E', weight:9, opacity:.16 }),
      L.polyline(r.path, { color:r.color, weight:5, opacity:.95, lineJoin:'round',
                           dashArray: mode==='walk' ? '2 10' : null,
                           lineCap:  mode==='walk' ? 'round' : 'butt' })
    ]).addTo(map);
    map.fitBounds(line.getBounds(), { padding:[55,55], maxZoom:17 });
  };

  const activeBtn = controlsEl.querySelector('.mbtn.active');
  drawOnMap(activeBtn ? activeBtn.dataset.mode : 'car');

  map.on('click', function(){ map.scrollWheelZoom.enable(); });
  map.on('mouseout', function(){ map.scrollWheelZoom.disable(); });

  setTimeout(function(){ map.invalidateSize(); shopMarker.openPopup(); }, 400);
})();
</script>
