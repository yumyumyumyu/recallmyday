(function render(){

  /* 6-1. 히어로 향 카드 회전 */
  const $ = id => document.getElementById(id);
  const scNo=$('scNo'), scName=$('scName'), scEn=$('scEn'), scNotes=$('scNotes'),
        scChip=$('scChip'), scDots=$('scDots');
  scDots.innerHTML = SCENTS.map(()=>'<i></i>').join('');
  let si = 0;
  function paintScent(i){
    const s = SCENTS[i];
    scNo.textContent = 'No.' + s.no;
    scNo.style.color = s.color;
    scName.textContent = s.ko;
    scEn.textContent = s.en;
    scChip.style.background = s.color;
    scNotes.innerHTML = s.notes.map(function(n){
      return '<div class="note-row"><b>'+n[0]+'</b><span class="txt">'+n[1]+'</span>'
           + '<span class="bar"><span style="width:'+n[2]+'%"></span></span></div>';
    }).join('');
    [].forEach.call(scDots.children, function(d,k){ d.classList.toggle('on', k===i); });
  }
  paintScent(0);
  setInterval(function(){ si = (si+1) % SCENTS.length; paintScent(si); }, 4000);

  /* 6-2. 티커 */
  const words = SCENTS.map(function(s){ return s.en + ' · ' + s.ko; });
  $('ticker').innerHTML = words.concat(words).map(function(w){ return '<span>'+w+'</span>'; }).join('');

  /* 6-3. 제품 탭 */
  const tabsEl = $('tabs'), panelsEl = $('panels');
  tabsEl.innerHTML = CATEGORIES.map(function(c,i){
    return '<button class="tab" role="tab" id="tab-'+c.id+'" aria-controls="panel-'+c.id+'"'
         + ' aria-selected="'+(i===0)+'" data-idx="'+i+'"><span class="emo">'+c.emo+'</span>'+c.name+'</button>';
  }).join('');

  panelsEl.innerHTML = CATEGORIES.map(function(c,i){
    return '<div class="panel" role="tabpanel" id="panel-'+c.id+'" aria-labelledby="tab-'+c.id+'" '+(i===0?'':'hidden')+'>'
      + '<div class="panel-intro"><div><h3>'+c.title+'</h3><p>'+c.desc+'</p></div>'
      + '<div class="price-from">'+c.priceFrom+'</div></div>'
      + '<div class="card-grid">'
      + c.items.map(function(p,j){
          return '<article class="pcard" style="animation-delay:'+(j*50)+'ms">'
            + '<div class="swatch" style="background:'+p.color+'"></div>'
            + (p.tag ? '<span class="tagline '+p.tag[0]+'">'+p.tag[1]+'</span>'
                     : '<span class="tagline" style="visibility:hidden">&nbsp;</span>')
            + '<h4>'+p.name+'</h4><div class="en">'+p.en+'</div><p>'+p.desc+'</p>'
            + '<div class="meta"><span class="price">'+p.price+'</span><span class="spec">'+p.spec+'</span></div>'
            + '</article>';
        }).join('')
      + '</div></div>';
  }).join('');

  tabsEl.addEventListener('click', function(e){
    const btn = e.target.closest('.tab');
    if(!btn) return;
    const idx = +btn.dataset.idx;
    [].forEach.call(tabsEl.querySelectorAll('.tab'), function(t,i){ t.setAttribute('aria-selected', i===idx); });
    const panels = panelsEl.querySelectorAll('.panel');
    [].forEach.call(panels, function(p,i){ p.hidden = (i!==idx); });
    [].forEach.call(panels[idx].querySelectorAll('.pcard'), function(card){
      card.style.animation = 'none'; void card.offsetWidth; card.style.animation = '';
    });
  });

  /* 6-4. 클래스 카드 */
  $('classGrid').innerHTML = PROGRAMS.map(function(p){
    const fee = p.price
      ? p.price.toLocaleString('ko-KR') + '원 <small>/ ' + p.unit + '</small>'
      : '견적 문의 <small>/ 10인 이상</small>';
    return '<div class="ccard'+(p.featured?' featured':'')+'">'
      + '<div class="dur">'+p.min+'분'+(p.featured?' · 대표 클래스':'')+'</div>'
      + '<h3>'+p.name+'</h3>'
      + '<ul>'+p.bullets.map(function(b){ return '<li>'+b+'</li>'; }).join('')+'</ul>'
      + '<div class="fee">'+fee+'</div>'
      + '</div>';
  }).join('');

  /* 6-5. 아이디어 */
  $('ideaGrid').innerHTML = IDEAS.map(function(i){
    return '<div class="icard"><div class="num">'+i.n+'</div><h4>'+i.t+'</h4>'
         + '<p>'+i.d+'</p><div class="why">▲ '+i.w+'</div></div>';
  }).join('');

  /* 6-6. 네비게이션 */
  const nav = $('nav');
  const onScroll = function(){ nav.classList.toggle('scrolled', window.scrollY > 50); };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive:true });
  const navLinks = $('navLinks');
  $('navToggle').addEventListener('click', function(){ navLinks.classList.toggle('open'); });
  navLinks.addEventListener('click', function(e){ if(e.target.tagName === 'A') navLinks.classList.remove('open'); });
