<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>제주조향아뜰리에 · 제주의 향을 직접 만드는 곳</title>
<meta name="description" content="제주시 신성로10길 3, 1층. 향수·디퓨저·샴푸바까지 직접 만드는 제주조향아뜰리에. 온라인 예약, 향 커스터마이징, 나만의 라벨 제작.">
<meta property="og:title" content="제주조향아뜰리에">
<meta property="og:description" content="제주의 향을 직접 만드는 조향 공방. 제주시청 도보 3분.">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<style>
/* ==========================================================
   제주조향아뜰리에 — 랜딩페이지 (단일 HTML)
   외부 의존성: Leaflet(지도)만 사용
   ========================================================== */

:root{
  /* ---- 밝은 제주 팔레트 ---- */
  --cream:      #FFFDF6;   /* 기본 배경 */
  --cream-2:    #FFF6E6;   /* 살구빛 섹션 */
  --cream-3:    #F1FBF8;   /* 민트빛 섹션 */
  --white:      #FFFFFF;

  --ink:        #2B332E;   /* 본문 텍스트 */
  --ink-soft:   #66736A;
  --ink-faint:  #97A29A;

  --tangerine:  #FF8A3D;   /* 감귤 (메인) */
  --tangerine-d:#F2711C;
  --tangerine-l:#FFEBD9;

  --mint:       #12BFB0;   /* 제주 바다 */
  --mint-d:     #0E9C90;
  --mint-l:     #D9F7F3;

  --sky:        #57C6F5;   /* 하늘 */
  --sky-l:      #E2F4FE;

  --canola:     #FFD43B;   /* 유채 */
  --canola-l:   #FFF6D4;

  --coral:      #FF6B7A;   /* 동백 */
  --coral-l:    #FFE5E8;

  --leaf:       #6FBF73;   /* 곶자왈 */
  --leaf-l:     #E4F5E5;

  --line:       rgba(43,51,46,.10);
  --line-2:     rgba(43,51,46,.16);

  --font: "Pretendard", "Apple SD Gothic Neo", "Noto Sans KR", -apple-system, BlinkMacSystemFont, "Malgun Gothic", sans-serif;
  --font-en: "Cormorant Garamond", Georgia, "Times New Roman", serif;

  --maxw: 1180px;
  --r: 20px;
  --r-s: 14px;
  --shadow: 0 18px 44px -26px rgba(43,51,46,.35);
  --shadow-lg: 0 30px 70px -34px rgba(43,51,46,.45);
}

*,*::before,*::after{ box-sizing:border-box; }
html{ scroll-behavior:smooth; scroll-padding-top:84px; }
body{
  margin:0; background:var(--cream); color:var(--ink);
  font-family:var(--font); font-size:16px; line-height:1.75;
  letter-spacing:-.012em; -webkit-font-smoothing:antialiased; overflow-x:hidden;
}
img{ max-width:100%; display:block; }
a{ color:inherit; text-decoration:none; }
button{ font-family:inherit; cursor:pointer; border:0; background:none; color:inherit; }
h1,h2,h3,h4{ margin:0; line-height:1.28; letter-spacing:-.035em; font-weight:800; }
p{ margin:0; }

.wrap{ width:100%; max-width:var(--maxw); margin:0 auto; padding:0 24px; }
.section{ padding:100px 0; position:relative; }
.eyebrow{
  display:inline-block; font-size:12px; font-weight:800; letter-spacing:.24em;
  text-transform:uppercase; color:var(--tangerine-d); margin-bottom:14px;
}
.section-head{ max-width:680px; margin-bottom:48px; }
.section-head h2{ font-size:clamp(27px,4.1vw,42px); margin-bottom:14px; }
.section-head p{ color:var(--ink-soft); font-size:17px; }

.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:9px;
  padding:15px 28px; border-radius:999px; font-weight:800; font-size:15px;
  border:2px solid transparent; transition:transform .18s ease, background .2s, border-color .2s, box-shadow .2s;
  white-space:nowrap;
}
.btn:hover{ transform:translateY(-2px); }
.btn-primary{ background:var(--tangerine); color:#fff; box-shadow:0 12px 26px -14px rgba(255,138,61,.9); }
.btn-primary:hover{ background:var(--tangerine-d); }
.btn-mint{ background:var(--mint); color:#fff; box-shadow:0 12px 26px -14px rgba(18,191,176,.9); }
.btn-mint:hover{ background:var(--mint-d); }
.btn-outline{ border-color:var(--line-2); color:var(--ink); background:var(--white); }
.btn-outline:hover{ border-color:var(--ink); }
.btn-ig{
  background:linear-gradient(120deg,#F9CE34,#EE2A7B 48%,#6228D7); color:#fff;
  box-shadow:0 12px 26px -14px rgba(238,42,123,.8);
}
.btn-block{ width:100%; }
.btn:disabled{ opacity:.42; cursor:not-allowed; transform:none !important; }

/* ---------------- NAV ---------------- */
header.nav{
  position:fixed; inset:0 0 auto 0; z-index:900; padding:14px 0;
  transition:background .3s, box-shadow .3s, padding .3s;
}
header.nav.scrolled{
  background:rgba(255,253,246,.9); backdrop-filter:blur(16px);
  box-shadow:0 1px 0 var(--line); padding:9px 0;
}
.nav-inner{ display:flex; align-items:center; justify-content:space-between; gap:20px; }
.logo{ display:flex; align-items:center; gap:10px; }
.logo .dot{
  width:34px; height:34px; border-radius:12px; display:grid; place-items:center; font-size:17px;
  background:linear-gradient(135deg,var(--canola),var(--tangerine)); box-shadow:0 8px 18px -10px rgba(255,138,61,.9);
}
.logo .mark{ font-size:18px; font-weight:800; letter-spacing:-.045em; }
.logo .sub{ display:block; font-size:9.5px; letter-spacing:.22em; color:var(--ink-faint); font-weight:700; margin-top:-3px; }
.nav-links{ display:flex; gap:26px; align-items:center; }
.nav-links a{ font-size:14.5px; font-weight:700; color:var(--ink-soft); transition:color .2s; }
.nav-links a:hover{ color:var(--ink); }
.nav-links a.nav-cta{
  background:var(--tangerine); color:#fff; padding:10px 20px; border-radius:999px; font-size:14px;
  box-shadow:0 10px 22px -12px rgba(255,138,61,.95);
}
.nav-links a.nav-cta:hover{ background:var(--tangerine-d); color:#fff; }
.nav-toggle{ display:none; font-size:22px; padding:6px 8px; }

/* ---------------- HERO ---------------- */
.hero{
  position:relative; min-height:100svh; display:flex; align-items:center;
  padding:132px 0 80px; overflow:hidden;
  background:
    radial-gradient(70% 60% at 82% 12%, var(--canola-l) 0%, transparent 62%),
    radial-gradient(65% 65% at 8% 78%, var(--mint-l) 0%, transparent 60%),
    radial-gradient(60% 50% at 55% 100%, var(--sky-l) 0%, transparent 60%),
    linear-gradient(170deg, #FFF9EC 0%, #FFFDF6 46%, #F3FBF9 100%);
}
.blob{ position:absolute; border-radius:50%; filter:blur(2px); opacity:.5; pointer-events:none; }
.b1{ width:280px; height:280px; background:radial-gradient(circle at 32% 30%, #FFD9B8, transparent 68%); top:8%; right:6%; }
.b2{ width:220px; height:220px; background:radial-gradient(circle at 40% 35%, #BFEFE8, transparent 68%); bottom:12%; left:2%; }
.hero-grid{ position:relative; z-index:2; display:grid; grid-template-columns:1.1fr .9fr; gap:52px; align-items:center; }
.hero h1{ font-size:clamp(36px,5.8vw,66px); margin-bottom:22px; letter-spacing:-.048em; }
.hero h1 .hl{ position:relative; white-space:nowrap; }
.hero h1 .hl::after{
  content:""; position:absolute; left:-2px; right:-2px; bottom:6px; height:.34em; z-index:-1;
  background:linear-gradient(90deg,var(--canola),var(--tangerine-l)); border-radius:6px;
}
.hero p.lead{ font-size:clamp(15.5px,1.85vw,18.5px); color:var(--ink-soft); max-width:520px; margin-bottom:32px; }
.hero-actions{ display:flex; gap:12px; flex-wrap:wrap; }
.hero-badges{ display:flex; gap:8px; flex-wrap:wrap; margin-bottom:22px; }
.badge{
  font-size:12.5px; font-weight:700; padding:7px 14px; border-radius:999px;
  background:var(--white); border:1px solid var(--line); color:var(--ink-soft); box-shadow:0 6px 16px -12px rgba(43,51,46,.5);
}
.badge b{ color:var(--tangerine-d); }

/* 히어로 향 카드 */
.scent-card{
  background:var(--white); border:1px solid var(--line); border-radius:26px; padding:30px;
  box-shadow:var(--shadow-lg);
}
.scent-card .top{ display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:18px; }
.scent-card .no{ font-family:var(--font-en); font-size:46px; line-height:1; font-weight:600; }
.scent-card h3{ font-size:25px; margin-top:6px; }
.scent-card .en{ font-size:11.5px; letter-spacing:.2em; color:var(--ink-faint); text-transform:uppercase; font-weight:700; }
.scent-card .chip{ width:52px; height:52px; border-radius:16px; flex:0 0 auto; box-shadow:0 10px 22px -12px rgba(0,0,0,.5); }
.notes{ display:grid; gap:11px; margin-bottom:20px; }
.note-row{ display:flex; align-items:center; gap:11px; font-size:13.5px; color:var(--ink-soft); }
.note-row b{ min-width:40px; font-size:10.5px; letter-spacing:.12em; color:var(--ink-faint); }
.note-row .txt{ flex:0 0 auto; }
.bar{ flex:1; min-width:30px; height:5px; border-radius:99px; background:var(--cream-2); overflow:hidden; }
.bar span{ display:block; height:100%; border-radius:99px; background:linear-gradient(90deg,var(--mint),var(--canola)); transition:width .5s ease; }
.rotate-hint{ font-size:11.5px; color:var(--ink-faint); display:flex; align-items:center; gap:7px; }
.rotate-hint .dots{ display:flex; gap:4px; }
.rotate-hint i{ width:5px; height:5px; border-radius:50%; background:var(--line-2); transition:background .3s, transform .3s; }
.rotate-hint i.on{ background:var(--tangerine); transform:scale(1.4); }

/* ---------------- 티커 ---------------- */
.ticker{ background:var(--ink); padding:13px 0; overflow:hidden; white-space:nowrap; }
.ticker-track{ display:inline-flex; gap:40px; animation:slide 36s linear infinite; }
.ticker span{ font-size:12.5px; letter-spacing:.2em; text-transform:uppercase; color:rgba(255,253,246,.6); font-weight:600; }
.ticker span::after{ content:"✿"; margin-left:40px; color:var(--canola); }
@keyframes slide{ from{transform:translateX(0);} to{transform:translateX(-50%);} }

/* ---------------- 스토리 ---------------- */
.story{ background:var(--cream); }
.story-grid{ display:grid; grid-template-columns:1.05fr .95fr; gap:60px; align-items:center; }
.story p{ font-size:16.5px; color:var(--ink-soft); }
.pull{
  font-size:clamp(20px,2.5vw,28px); font-weight:800; line-height:1.5; letter-spacing:-.038em;
  color:var(--ink); margin:28px 0; padding-left:20px; border-left:4px solid var(--tangerine);
}
.stat-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:14px; }
.stat{
  background:var(--white); border:1px solid var(--line); border-radius:var(--r); padding:26px 24px;
  box-shadow:var(--shadow);
}
.stat b{ display:block; font-family:var(--font-en); font-size:38px; line-height:1; font-weight:600; }
.stat small{ display:block; margin-top:8px; font-size:13.5px; color:var(--ink-soft); line-height:1.6; }

/* ---------------- 제품 탭 ---------------- */
.products{ background:linear-gradient(180deg, var(--cream-2), var(--cream) 60%); }
.tabs{ display:flex; gap:8px; overflow-x:auto; padding:4px 4px 12px; margin-bottom:34px; }
.tabs::-webkit-scrollbar{ height:5px; }
.tabs::-webkit-scrollbar-thumb{ background:var(--line-2); border-radius:99px; }
.tab{
  flex:0 0 auto; padding:11px 20px; border-radius:999px; font-size:14.5px; font-weight:700;
  background:var(--white); border:1px solid var(--line); color:var(--ink-soft);
  transition:all .2s; white-space:nowrap;
}
.tab:hover{ border-color:var(--line-2); color:var(--ink); }
.tab[aria-selected="true"]{
  background:var(--tangerine); border-color:var(--tangerine); color:#fff;
  box-shadow:0 10px 22px -13px rgba(255,138,61,.95);
}
.tab .emo{ margin-right:6px; }
.panel[hidden]{ display:none; }
.panel-intro{ display:flex; justify-content:space-between; align-items:flex-end; gap:22px; flex-wrap:wrap; margin-bottom:26px; }
.panel-intro h3{ font-size:25px; margin-bottom:8px; }
.panel-intro p{ color:var(--ink-soft); font-size:15.5px; max-width:660px; }
.price-from{
  font-size:13px; font-weight:800; color:var(--tangerine-d); background:var(--tangerine-l);
  padding:8px 16px; border-radius:999px; white-space:nowrap;
}
.card-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(256px,1fr)); gap:18px; }
.pcard{
  background:var(--white); border:1px solid var(--line); border-radius:var(--r); padding:24px;
  display:flex; flex-direction:column; gap:11px; box-shadow:0 10px 30px -24px rgba(43,51,46,.6);
  transition:transform .25s ease, box-shadow .25s, border-color .25s;
  animation:fadeUp .45s ease both;
}
.pcard:hover{ transform:translateY(-6px); box-shadow:var(--shadow-lg); border-color:var(--tangerine); }
@keyframes fadeUp{ from{opacity:0; transform:translateY(14px);} to{opacity:1; transform:none;} }
.pcard .swatch{ width:44px; height:44px; border-radius:14px; box-shadow:inset 0 0 0 1px rgba(0,0,0,.06); }
.pcard h4{ font-size:18px; }
.pcard .en{ font-family:var(--font-en); font-size:12.5px; letter-spacing:.14em; color:var(--ink-faint); text-transform:uppercase; margin-top:-7px; }
.pcard p{ font-size:14.5px; color:var(--ink-soft); flex:1; }
.pcard .meta{ display:flex; justify-content:space-between; align-items:center; gap:10px; padding-top:13px; border-top:1px solid var(--line); font-size:13.5px; }
.pcard .meta .price{ font-weight:800; color:var(--tangerine-d); }
.pcard .meta .spec{ color:var(--ink-faint); font-size:12.5px; text-align:right; }
.tagline{ align-self:flex-start; font-size:11.5px; font-weight:800; letter-spacing:.04em; padding:4px 10px; border-radius:7px; }
.t-best{ background:var(--tangerine-l); color:var(--tangerine-d); }
.t-new{ background:var(--mint-l); color:var(--mint-d); }
.t-limit{ background:var(--coral-l); color:#D9455A; }
.t-eco{ background:var(--leaf-l); color:#3E8C43; }

/* ---------------- 클래스 ---------------- */
.classes{ background:var(--cream-3); }
.class-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(266px,1fr)); gap:20px; }
.ccard{
  background:var(--white); border:1px solid var(--line); border-radius:var(--r); padding:30px 26px;
  display:flex; flex-direction:column; gap:13px; box-shadow:0 10px 30px -24px rgba(43,51,46,.6);
  transition:transform .25s ease, box-shadow .25s;
}
.ccard:hover{ transform:translateY(-6px); box-shadow:var(--shadow-lg); }
.ccard.featured{ background:linear-gradient(160deg,var(--tangerine),#FFA45C); color:#fff; border-color:transparent; }
.ccard .dur{ font-size:11.5px; font-weight:800; letter-spacing:.14em; color:var(--tangerine-d); text-transform:uppercase; }
.ccard.featured .dur{ color:#FFF3D8; }
.ccard h3{ font-size:21px; }
.ccard ul{ margin:0; padding-left:17px; font-size:14.5px; color:var(--ink-soft); display:grid; gap:6px; }
.ccard.featured ul{ color:rgba(255,255,255,.94); }
.ccard .fee{ font-size:21px; font-weight:800; letter-spacing:-.03em; margin-top:auto; padding-top:12px; }
.ccard .fee small{ font-size:12.5px; font-weight:600; color:var(--ink-faint); }
.ccard.featured .fee small{ color:rgba(255,255,255,.8); }

/* ---------------- 라벨 커스텀 ---------------- */
.label-sec{ background:var(--cream); }
.label-grid{ display:grid; grid-template-columns:.95fr 1.05fr; gap:56px; align-items:center; }
.label-list{ display:grid; gap:14px; margin-top:26px; }
.label-item{ display:flex; gap:14px; align-items:flex-start; }
.label-item .n{
  width:28px; height:28px; border-radius:9px; flex:0 0 auto; display:grid; place-items:center;
  background:var(--tangerine-l); color:var(--tangerine-d); font-size:13px; font-weight:800;
}
.label-item b{ display:block; font-size:15.5px; }
.label-item span{ font-size:14.5px; color:var(--ink-soft); }
.label-preview{ display:grid; grid-template-columns:repeat(2,1fr); gap:16px; }
.bottle{
  background:var(--white); border:1px solid var(--line); border-radius:var(--r);
  padding:22px 18px; text-align:center; box-shadow:var(--shadow);
  transition:transform .25s;
}
.bottle:hover{ transform:translateY(-5px) rotate(-1deg); }
.bottle .glass{
  height:112px; border-radius:10px 10px 16px 16px; margin:0 auto 14px; width:74px; position:relative;
  box-shadow:inset -8px 0 14px -8px rgba(0,0,0,.16), inset 8px 0 14px -8px rgba(255,255,255,.7);
}
.bottle .glass::before{
  content:""; position:absolute; top:-13px; left:50%; transform:translateX(-50%);
  width:26px; height:14px; border-radius:5px 5px 2px 2px; background:#C9A97A;
}
.bottle .lbl{
  position:absolute; left:8px; right:8px; top:34px; padding:7px 5px; border-radius:5px;
  background:rgba(255,255,255,.94); font-size:9.5px; font-weight:800; color:var(--ink); line-height:1.35;
  box-shadow:0 2px 8px -4px rgba(0,0,0,.4);
}
.bottle .lbl em{ display:block; font-style:normal; font-size:8px; color:var(--ink-faint); letter-spacing:.08em; }
.bottle .cap{ font-size:13px; font-weight:700; }
.bottle .cap small{ display:block; font-size:11.5px; color:var(--ink-faint); font-weight:500; }

/* ---------------- 향 커스터마이징 CTA ---------------- */
.custom-cta{
  background:linear-gradient(135deg, var(--mint) 0%, #35D0C0 55%, var(--sky) 100%);
  color:#fff; padding:76px 0;
}
.custom-inner{ display:flex; align-items:center; justify-content:space-between; gap:36px; flex-wrap:wrap; }
.custom-inner h2{ font-size:clamp(25px,3.4vw,36px); margin-bottom:12px; }
.custom-inner p{ color:rgba(255,255,255,.9); font-size:16.5px; max-width:560px; }
.custom-cta .btn-outline{ background:#fff; border-color:#fff; color:var(--mint-d); }

/* ---------------- 아이디어 ---------------- */
.ideas{ background:var(--cream-2); }
.idea-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(298px,1fr)); gap:16px; }
.icard{
  background:var(--white); border:1px solid var(--line); border-radius:var(--r); padding:24px;
  transition:transform .2s, box-shadow .2s;
}
.icard:hover{ transform:translateY(-4px); box-shadow:var(--shadow); }
.icard .num{ font-family:var(--font-en); font-size:12.5px; letter-spacing:.2em; color:var(--tangerine); font-weight:700; }
.icard h4{ font-size:18px; margin:7px 0 9px; }
.icard p{ font-size:14.5px; color:var(--ink-soft); margin-bottom:13px; }
.icard .why{ font-size:13px; color:var(--mint-d); font-weight:700; background:var(--mint-l); padding:8px 12px; border-radius:9px; }
.pick-note{
  margin-top:30px; padding:22px 26px; border-radius:var(--r);
  background:var(--white); border:1px dashed var(--tangerine); display:flex; gap:15px; align-items:flex-start;
  font-size:15px; color:var(--ink-soft);
}
.pick-note b{ color:var(--tangerine-d); }

/* ---------------- 예약 ---------------- */
.booking{ background:var(--cream); }
.book-layout{ display:grid; grid-template-columns:1.15fr .85fr; gap:24px; align-items:start; }
.book-panel{
  background:var(--white); border:1px solid var(--line); border-radius:var(--r);
  padding:28px; box-shadow:var(--shadow);
}
.step-label{
  display:flex; align-items:center; gap:9px; font-size:12.5px; font-weight:800;
  letter-spacing:.1em; text-transform:uppercase; color:var(--ink-faint); margin-bottom:14px;
}
.step-label i{
  width:22px; height:22px; border-radius:7px; display:grid; place-items:center; font-style:normal;
  background:var(--tangerine); color:#fff; font-size:12px;
}
.prog-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:10px; margin-bottom:28px; }
.prog{
  text-align:left; padding:15px 16px; border-radius:var(--r-s); border:2px solid var(--line);
  background:var(--white); transition:all .2s;
}
.prog:hover{ border-color:var(--line-2); }
.prog[aria-pressed="true"]{ border-color:var(--tangerine); background:var(--tangerine-l); }
.prog b{ display:block; font-size:15px; }
.prog span{ font-size:12.5px; color:var(--ink-soft); }
.prog em{ display:block; font-style:normal; font-size:13px; font-weight:800; color:var(--tangerine-d); margin-top:5px; }

.cal-head{ display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
.cal-head b{ font-size:17px; font-weight:800; }
.cal-nav{ display:flex; gap:6px; }
.cal-nav button{
  width:34px; height:34px; border-radius:10px; border:1px solid var(--line);
  display:grid; place-items:center; font-size:15px; transition:all .2s; background:var(--white);
}
.cal-nav button:hover:not(:disabled){ border-color:var(--ink); }
.cal-grid{ display:grid; grid-template-columns:repeat(7,1fr); gap:5px; }
.cal-grid .dow{ text-align:center; font-size:11.5px; font-weight:800; color:var(--ink-faint); padding:6px 0; }
.cal-grid .dow.sun{ color:var(--coral); }
.day{
  aspect-ratio:1/1; border-radius:11px; display:grid; place-items:center; position:relative;
  font-size:14px; font-weight:700; border:1px solid transparent; background:var(--cream-2); color:var(--ink);
  transition:all .16s;
}
.day.empty{ background:none; }
.day:disabled{ background:transparent; color:var(--ink-faint); opacity:.42; text-decoration:line-through; }
.day:not(:disabled):hover{ background:var(--tangerine-l); border-color:var(--tangerine); }
.day[aria-pressed="true"]{ background:var(--tangerine); color:#fff; box-shadow:0 8px 18px -10px rgba(255,138,61,1); }
.day.today::after{
  content:""; position:absolute; bottom:6px; left:50%; transform:translateX(-50%);
  width:4px; height:4px; border-radius:50%; background:var(--mint);
}
.day[aria-pressed="true"].today::after{ background:#fff; }
.cal-legend{ display:flex; gap:16px; flex-wrap:wrap; margin-top:14px; font-size:12.5px; color:var(--ink-faint); }
.cal-legend span{ display:flex; align-items:center; gap:6px; }
.cal-legend i{ width:9px; height:9px; border-radius:3px; display:block; }

.slot-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(88px,1fr)); gap:8px; }
.slot{
  padding:11px 6px; border-radius:11px; border:2px solid var(--line); background:var(--white);
  font-size:14px; font-weight:700; transition:all .18s;
}
.slot:hover:not(:disabled){ border-color:var(--mint); }
.slot[aria-pressed="true"]{ background:var(--mint); border-color:var(--mint); color:#fff; }
.slot:disabled{ opacity:.35; }
.slot-empty{ font-size:14.5px; color:var(--ink-faint); padding:14px 2px; }

.field{ margin-bottom:14px; }
.field label{ display:block; font-size:13px; font-weight:800; margin-bottom:6px; color:var(--ink-soft); }
.field input, .field textarea, .field select{
  width:100%; padding:12px 14px; border-radius:var(--r-s); border:2px solid var(--line);
  font-family:inherit; font-size:15px; color:var(--ink); background:var(--white); transition:border-color .2s;
}
.field input:focus, .field textarea:focus, .field select:focus{ outline:none; border-color:var(--mint); }
.field textarea{ resize:vertical; min-height:72px; }
.field .hint{ font-size:12.5px; color:var(--ink-faint); margin-top:5px; }

/* 예약 요약 (sticky) */
.summary{
  position:sticky; top:96px; background:var(--white); border:1px solid var(--line);
  border-radius:var(--r); padding:26px; box-shadow:var(--shadow-lg);
}
.summary h3{ font-size:19px; margin-bottom:4px; }
.summary .sub{ font-size:13.5px; color:var(--ink-faint); margin-bottom:20px; }
.sum-row{ display:flex; justify-content:space-between; gap:14px; padding:11px 0; border-bottom:1px dashed var(--line); font-size:14.5px; }
.sum-row dt{ color:var(--ink-faint); font-weight:700; flex:0 0 auto; }
.sum-row dd{ margin:0; font-weight:700; text-align:right; }
.sum-row dd.todo{ color:var(--ink-faint); font-weight:600; }
.sum-total{ display:flex; justify-content:space-between; align-items:center; padding:16px 0 20px; font-size:15px; }
.sum-total b{ font-size:23px; font-weight:800; color:var(--tangerine-d); letter-spacing:-.03em; }
.summary .actions{ display:grid; gap:9px; }
.summary .note{
  margin-top:16px; font-size:12.5px; color:var(--ink-faint); line-height:1.65;
  background:var(--cream-2); padding:13px 15px; border-radius:12px;
}
.copied{
  margin-top:10px; font-size:13px; font-weight:700; color:var(--mint-d);
  background:var(--mint-l); padding:10px 14px; border-radius:11px; display:none;
}
.copied.show{ display:block; animation:fadeUp .3s ease; }
.hours-box{
  margin-top:16px; background:var(--cream-3); border-radius:var(--r-s); padding:16px 18px; font-size:13.5px; color:var(--ink-soft);
}
.hours-box b{ display:block; color:var(--ink); font-size:14px; margin-bottom:6px; }

/* ---------------- 오시는 길 ---------------- */
.visit{ background:var(--cream-3); }
.map-controls{ display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px; }
.mbtn{
  padding:10px 18px; border-radius:999px; font-size:13.5px; font-weight:700;
  background:var(--white); border:1px solid var(--line); color:var(--ink-soft); transition:all .2s;
}
.mbtn:hover{ border-color:var(--line-2); color:var(--ink); }
.mbtn.active{ background:var(--mint); border-color:var(--mint); color:#fff; box-shadow:0 10px 22px -13px rgba(18,191,176,1); }
.map-layout{ display:grid; grid-template-columns:1.35fr .65fr; gap:20px; }
#map{
  height:520px; border-radius:var(--r); overflow:hidden; z-index:1;
  border:1px solid var(--line); background:var(--white); box-shadow:var(--shadow);
}
.leaflet-container{ font-family:var(--font); background:#F3FBF9; }
.leaflet-popup-content-wrapper{ border-radius:13px; }
.leaflet-popup-content{ margin:14px 16px; font-size:13.5px; line-height:1.6; }
.leaflet-popup-content b{ display:block; font-size:14.5px; margin-bottom:3px; }
.map-side{ display:flex; flex-direction:column; gap:12px; }
.route-card{ background:var(--white); border:1px solid var(--line); border-radius:var(--r-s); padding:19px 21px; box-shadow:0 8px 26px -22px rgba(43,51,46,.7); }
.route-card h4{ font-size:15.5px; display:flex; align-items:center; gap:9px; margin-bottom:7px; }
.route-card h4 .ico{ width:28px; height:28px; border-radius:9px; display:grid; place-items:center; font-size:14px; background:var(--tangerine-l); }
.route-card p{ font-size:13.8px; color:var(--ink-soft); }
.route-card .time{ font-size:12.5px; color:var(--tangerine-d); font-weight:800; margin-top:8px; }
.info-strip{ margin-top:22px; display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px; }
.info-strip div{ background:var(--white); border:1px solid var(--line); border-radius:var(--r-s); padding:20px 22px; }
.info-strip dt{ font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--tangerine-d); font-weight:800; margin-bottom:6px; }
.info-strip dd{ margin:0; font-size:15px; font-weight:700; }
.info-strip dd small{ display:block; color:var(--ink-faint); font-size:13px; font-weight:500; margin-top:3px; }

/* ---------------- FAQ ---------------- */
.faq{ background:var(--cream); }
.faq-list{ max-width:830px; }
details.q{ border-bottom:1px solid var(--line); padding:19px 0; }
details.q summary{
  list-style:none; cursor:pointer; font-size:16.5px; font-weight:800; letter-spacing:-.025em;
  display:flex; justify-content:space-between; gap:18px; align-items:center;
}
details.q summary::-webkit-details-marker{ display:none; }
details.q summary::after{ content:"+"; font-size:21px; font-weight:400; color:var(--tangerine); transition:transform .25s; }
details.q[open] summary::after{ transform:rotate(45deg); }
details.q p{ margin-top:12px; color:var(--ink-soft); font-size:15.5px; }

/* ---------------- FOOTER ---------------- */
footer{ background:var(--ink); color:rgba(255,253,246,.6); padding:60px 0 34px; font-size:14px; }
.foot-grid{ display:grid; grid-template-columns:1.4fr 1fr 1fr; gap:36px; margin-bottom:38px; }
footer h5{ color:var(--cream); font-size:13px; letter-spacing:.14em; text-transform:uppercase; margin:0 0 14px; }
footer ul{ list-style:none; margin:0; padding:0; display:grid; gap:8px; }
footer a:hover{ color:var(--cream); }
footer .logo .mark{ color:var(--cream); }
footer .logo .sub{ color:rgba(255,253,246,.45); }
.foot-bottom{ border-top:1px solid rgba(255,253,246,.14); padding-top:20px; display:flex; justify-content:space-between; gap:18px; flex-wrap:wrap; font-size:12.5px; }
.ig-line{ display:inline-flex; align-items:center; gap:8px; color:var(--canola); font-weight:700; }

